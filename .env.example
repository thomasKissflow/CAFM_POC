# Copy to .env in this same folder and fill in. .env is gitignored and must stay that way.
# Nothing here is VITE_-prefixed, so none of it is ever bundled into the frontend.

# --- Kissflow -----------------------------------------------------------------
# The account the CAFM app lives in. Ask Thomas, or use your own dev account and
# re-run the build in data-model/ against it.
KF_DOMAIN=development-r1100.kissflow.com
KF_ACCOUNT_ID=
# An API key pair from Kissflow: Settings -> Integrations -> API keys.
# It needs admin rights on the app CAFM_POC_A00.
KF_ACCESS_KEY_ID=
KF_ACCESS_KEY_SECRET=

# --- Google Gemini ------------------------------------------------------------
# Only needed for the live voice agent, the call summariser and the video
# narration. Everything else runs without it. Get one at aistudio.google.com.
GEMINI_API_KEY=
# Optional overrides; the defaults in app/src/ai are current.
# GEMINI_LIVE_MODEL=
# GEMINI_TEXT_MODEL=

# --- Anthropic (optional) -----------------------------------------------------
# Only for the dev-only scripted voice brain proxy. Not needed for the demo.
# ANTHROPIC_API_KEY=
# CAFM_VOICE_MODEL=claude-opus-5
